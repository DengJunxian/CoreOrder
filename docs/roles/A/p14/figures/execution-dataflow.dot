digraph CoreOrder {
  graph [layout=neato, overlap=true, splines=line, bgcolor="white", pad=0.13,
         outputorder=edgesfirst]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        width=2.35, height=0.68, fixedsize=true, penwidth=1.2,
        color="#9DB2C8", fillcolor="#F0F5FA", fontcolor="#142B41", pin=true]
  edge [color="#46637C", penwidth=1.2, arrowsize=0.72]

  pams [pos="0,168!", label="PAMS market step\nState, event hooks, runner RNG"]
  batch [pos="195,168!", label="A · Safe FCN prefix\nQuota, visits, Gaussian draws",
         color="#508A8A", fillcolor="#E7F4F0"]
  pack [pos="390,168!", label="D · Live AoS or SoA packing\nSnapshot, draws, row metadata"]

  commit [pos="0,85!", label="PAMS order processing\nSubmit, HFT, match, settle"]
  rebuild [pos="195,85!", label="A · Rebuild PAMS orders\nConsume slots in original order",
           color="#508A8A", fillcolor="#E7F4F0"]
  native [pos="390,85!", label="B · Shared FCN kernel\nDirect loop or C's Taskflow pool"]
  heap [pos="0,3!", label="A · Heap restoration switch\nUpstream heapify or heappush",
        color="#508A8A", fillcolor="#E7F4F0"]
  compare [pos="195,3!", label="E · Structural comparison\nEvents, state, accounts, RNG",
           color="#9B8FB5", fillcolor="#F4F0F8"]
  oracle [pos="390,3!", label="Independent PAMS oracle\nSame input and seed"]

  pams -> batch -> pack -> native -> rebuild -> commit
  commit -> heap [dir=both]
  commit -> compare [style=dashed]
  oracle -> compare [style=dashed]
}
